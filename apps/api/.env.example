APP_ENV=development
PORT=8080
HOST=127.0.0.1
DATABASE_PATH=data/marketplace.sqlite
PUBLIC_URL=http://localhost:8080
APP_URL=http://localhost:7357
MERCHANT_APP_URL=http://localhost:7358
ALLOWED_ORIGINS=http://localhost:7357,http://127.0.0.1:7357,http://localhost:7358,http://127.0.0.1:7358,http://localhost:7359,http://127.0.0.1:7359
SEED_DEMO=true
# Public fictional accounts; opt-in local sandbox only. Prefer tool/demo.sh (isolated DB).
DEMO_SHOWCASE=false
PAYMENT_MODE=sandbox
# Set PAYMENT_MODE=stripe and configure these server-side values for real payments.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CLUB_PRICE_ID=
# Seller onboarding and settlement. Platform commission in basis points (100 = 1%).
STRIPE_CONNECT_ENABLED=false
PLATFORM_COMMISSION_BPS=0
SETTLEMENT_DELAY_HOURS=24
# Initial preference for newly connected sellers; each owner can change it in Finance.
AUTOMATIC_SETTLEMENTS=false
# Native iOS wallet: must match the Merchant ID enabled in Xcode and Stripe.
APPLE_PAY_MERCHANT_ID=
MERCHANT_COUNTRY=SK
ADMIN_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Optional: Firebase Admin service account file, stored outside source control.
FIREBASE_SERVICE_ACCOUNT_FILE=
FIREBASE_AUTH_PROJECT_ID=
FIREBASE_AUTH_API_KEY=
FIREBASE_AUTH_GOOGLE_ENABLED=false
FIREBASE_AUTH_APPLE_ENABLED=false

# Photon /api endpoint. Public demo for development only; self-host or choose a provider for production.
GEOCODER_URL=https://photon.komoot.io/api/

# Account recovery / verification and operational messages. Secrets stay server-side.
RESEND_API_KEY=
MAIL_FROM=
# Existing verified account emails; bootstrap does not create a privileged identity.
PLATFORM_ADMIN_EMAILS=
BILLING_FONT_PATH=apps/mobile/assets/fonts/InterVariable.ttf
# Confirmed seller: the shop issues food invoices; platform fees remain separate.
BILLING_SELLER_MODEL=merchantSeller
