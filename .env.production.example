# Copy to .env.production and replace every example.invalid hostname.
# Activation of payment providers is intentionally a separate final stage.
PUBLIC_URL=https://api.example.invalid
APP_URL=https://app.example.invalid
MERCHANT_APP_URL=https://merchant.example.invalid
ALLOWED_ORIGINS=https://app.example.invalid,https://merchant.example.invalid,https://admin.example.invalid
API_HOST=api.example.invalid
CUSTOMER_HOST=app.example.invalid
MERCHANT_HOST=merchant.example.invalid
ADMIN_HOST=admin.example.invalid
TLS_EMAIL=ops@example.invalid
RESEND_API_KEY=
MAIL_FROM=
PLATFORM_ADMIN_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FIREBASE_SERVICE_ACCOUNT_FILE=
FIREBASE_AUTH_PROJECT_ID=
FIREBASE_AUTH_API_KEY=
FIREBASE_AUTH_GOOGLE_ENABLED=false
FIREBASE_AUTH_APPLE_ENABLED=false
GEOCODER_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_CONNECT_ENABLED=false
AUTOMATIC_SETTLEMENTS=false
BILLING_FONT_PATH=/app/fonts/InterVariable.ttf
BILLING_SELLER_MODEL=merchantSeller
